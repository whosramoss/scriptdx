{
  "name": "scriptdx",
  "version": "1.0.0",
  "description": "A terminal toolkit for colorful logs, loading effects, and developer-friendly CLI output.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "docs",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "tutorial": "npx tsx docs/example.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "keywords": [
    "ansi",
    "colors",
    "terminal",
    "cli",
    "logging",
    "spinner",
    "typescript"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/whosramoss/scriptdx.git"
  },
  "homepage": "https://scriptdx.whosramoss.com",
  "bugs": {
    "url": "https://github.com/whosramoss/scriptdx/issues"
  },
  "author": "Gabriel Ramos (https://github.com/whosramoss)",
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/node": "^22.10.1",
    "eslint": "^9.15.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.16.0",
    "vitest": "^2.1.6"
  }
}
